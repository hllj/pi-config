{
  "name": "pi-config",
  "version": "0.1.0",
  "private": true,
  "description": "Personal pi coding agent extensions, agents, and prompts",
  "type": "module",
  "scripts": {
    "postinstall": "npm install --prefix monitor --no-audit --no-fund",
    "setup": "bash scripts/setup-links.sh",
    "setup:agent": "bash scripts/setup-agent-links.sh",
    "setup:all": "npm run setup:agent && npm run setup",
    "verify": "bash scripts/verify-setup.sh",
    "verify:live": "bash scripts/verify-setup.sh --live",
    "pretypecheck": "npm run setup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:subagent": "bash subagent/tests/run-unit.sh",
    "test:subagent:widget": "bash subagent/tests/run-widget.sh",
    "test:subagent:watchdog": "bash subagent/tests/run-watchdog.sh",
    "test:subagent:workflow-budget": "bash subagent/tests/run-workflow-budget.sh",
    "test:subagent:expect": "bash subagent/tests/run-expect.sh",
    "test:todo": "node todo/todo-widget.test.ts",
    "test:dev-workflows": "node tests/dev-workflows.test.ts",
    "test:verify-guard": "node tests/verify-guard.test.ts",
    "test:trigger-compact": "node tests/trigger-compact.test.ts",
    "test:learning": "node learning/failure-store.test.ts",
    "test:notes": "node session-memory/lib.test.ts",
    "test": "npm run test:subagent && npm run test:subagent:widget && npm run test:subagent:watchdog && npm run test:subagent:workflow-budget && npm run test:subagent:expect && npm run test:todo && npm run test:dev-workflows && npm run test:verify-guard && npm run test:trigger-compact && npm run test:learning && npm run test:notes",
    "check": "npm run setup && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.68.0"
  }
}
